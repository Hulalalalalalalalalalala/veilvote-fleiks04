{
  "name": "veilvote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --watch src/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node src/server.ts",
    "test": "node --test test/catalog.test.ts test/group.test.ts test/votes.test.ts test/admin.test.ts test/closeout.test.ts test/frontend.test.ts",
    "demo": "node scripts/demo.ts"
  },
  "dependencies": {
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/identity": "4.14.3",
    "@semaphore-protocol/proof": "4.14.3",
    "snarkjs": "0.7.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.10.1",
    "jsdom": "^30.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
