{
  "name": "veilvote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --watch src/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node src/server.ts",
    "test": "node --test --test-force-exit test/*.test.ts",
    "demo": "node scripts/demo.ts"
  },
  "dependencies": {
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/identity": "4.14.3",
    "@semaphore-protocol/proof": "4.14.3",
    "ethers": "6.13.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
